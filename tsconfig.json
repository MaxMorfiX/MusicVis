{
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",          
    "outDir": "./dist",   
    "declaration": true,          
    "declarationMap": true,     
    "module": "ES2015",
    "moduleResolution": "node",
    "target": "ES2015",
    "strict": true
  },
  "include": ["src/**/*"],        
  "exclude": ["node_modules", "dist"]
}